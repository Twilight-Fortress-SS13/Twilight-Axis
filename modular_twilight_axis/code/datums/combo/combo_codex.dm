/obj/item/recipe_book/combo_core_library
	name = "Combat Schools Compendium"
	wiki_name = "Combat Schools"
	wiki_section = "Guides"
	can_spawn = FALSE
	wiki_only = TRUE
	icon_state = "book4_0"
	base_icon_state = "book4"

	types = list(/datum/book_entry/combo_core)

/datum/book_entry/combo_core
