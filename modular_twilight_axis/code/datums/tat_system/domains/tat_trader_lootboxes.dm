	if(roll <= 50)
		tat_add_weighted_lootbox_reward(rewards, GLOB.tat_trader_lootbox_medium_base_pool, 5)
	else if(roll <= 90)
		tat_add_weighted_lootbox_reward(rewards, GLOB.tat_trader_lootbox_expensive_base_pool, 4)
