
/obj/item/clothing/head/roguetown/helmet/blacksteel/legate
	name = "legate's helmet"
	desc = "Немногие смогли доказать верностью и умением свое право получить черносталевый шлем, переплавленный из лат павших рыцарей Запада и украшенный остатками их знамен. Легат - полководец, что служит великому наместнику из Дома Аурелиев. \
	Каждый легат получает золотую маску, отлитую по слепку его лица, что доказывает его право на власть. Верхушку шлема украшают золотые шипы, переплавленные из венцов дворян Черной Империи. \
	</br>‎  </br>Чье лицо скрыто под этой маской - человека или лишь безропотного орудия? Надевая неизменный лик, постарайся не забыть свой собственный."
	icon = 'modular_twilight_axis/icons/roguetown/clothing/head.dmi'
